{
	"name": "@earendil-works/pi-rag-ime-runtime-host",
	"version": "0.87.1",
	"description": "Product-owned Pi runtime adapter for Wisdom Weasel and PAW integrations",
	"license": "MIT",
	"type": "module",
	"private": true,
	"bin": {
		"rag-ime-runtime-host": "dist/cli.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"pi-packages",
		"README.md"
	],
	"scripts": {
		"clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
		"build": "cd ../.. && npm run build:rag-ime-runtime-host",
		"test": "cd ../.. && npm run test:rag-ime-runtime-host"
	},
	"dependencies": {
		"@earendil-works/pi-ai": "0.87.1",
		"@earendil-works/pi-coding-agent": "0.87.1"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
